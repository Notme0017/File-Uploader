<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include("partials/nav") %>

    <div class="page-container">
        <h2 class="page-title">Upload File</h2>

        <% if (typeof error !== "undefined" && error) { %>
            <p class="error-inline"><%= error %></p>
        <% } %>

        <form action="/files/upload" method="POST" enctype="multipart/form-data" class="form-card">
            <input type="hidden" name="folderId" value="<%= folderId %>">

            <div class="form-field">
                <label for="file">Choose file</label>
                <input type="file" id="file" name="file" required>
                <p class="field-hint">Accepted: images, PDF, DOC/DOCX, TXT. Max size: 10MB.</p>
            </div>

            <button type="submit" class="btn">Upload</button>
        </form>
    </div>
</body>
</html>