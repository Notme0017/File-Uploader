<div class="file">
    <span class="file-name"><%= file.name %></span>
    <span class="file-size"><%= file.size %> bytes</span>
    <span class="time"><%= file.uploadedAt.toLocaleDateString() %></span>
    <div class="item-actions">
        <a href="/files/<%= file.id %>/rename">Rename</a>
        <a href="/files/<%= file.id %>/move">Move</a>
        <a href="/files/<%= file.id %>">Open</a>
        <form action="/files/<%= file.id %>/delete" method="post">
            <button type="submit" class="btn-link" onclick="return confirm(`Are you sure you want to delete <%= file.name %>?`)">Delete</button>
        </form>
    </div>
</div>