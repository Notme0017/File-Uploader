<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=title%></title>
</head>
<body>
    <%-include("partials/nav")%>
    <nav class="breadcrumbs">
        <a href="/dashboard">Home</a>
        <% breadcrumbs.forEach((crumb) =>{%>
            / <a href="/folders/<%=crumb.id%>"><%=crumb.name%></a>
        <%})%>
    </nav>
    <h2><%=folder.name%></h2>

    <a href="/folders/new?parentId=<%=folder.id%>">New Subfolder</a>
    <a href="/files/upload?folderId=<%=folder.id%>">Add File</a>
    <a href="/folders/<%=folder.id%>/rename">Rename</a>
    <form action="/folders/<%=folder.id%>/delete" method="post">
        <button type="submit" onclick="return confirm(`Are you sure you want to delete the folder <%=folder.name%> and all it's children files and folders?`)">Delete</button> 
    </form>

    <ul class="folder-list">
        <% folder.children.forEach((child) =>{%>
            <li> 
                <a href="/folders/<%=child.id%>">
                    <div class="folder">
                        <span class="folder-name"><%=child.name%></span>
                        <span class="time"><%=child.createdAt.toLocaleDateString()%></span>
                    </div>
                </a>
            </li>
        <%})%>
    </ul>

    <ul class="file-list">
        <% folder.files.forEach((file) =>{%>
            <li>
                <%-include("partials/file", {file: file})%>
            </li>
        <%})%>
    </ul>
</body>
</html>