<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%title%></title>
</head>
<body>
    <%-include("partials/nav")%>
    <h2>Rename, <%=folder.name%></h2>

    <%-include("partials/errors")%>
    <form action="/folders/<%=folder.id%>/rename" method="post" class="rename-folder-form">
        <label for="name">Name</label>
        <input type="text" name="name" value="<%folder.name|| ''%>" id="name" />

        <button type="submit">Rename</button>
    </form>
</body>
</html>