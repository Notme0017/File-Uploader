<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= file.name %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include("partials/nav") %>

    <div class="page-container">
        <h2 class="page-title"><%= file.name %></h2>

        <ul class="detail-list">
            <li><strong>Size:</strong> <%= file.size %> bytes</li>
            <li><strong>Type:</strong> <%= file.mimeType %></li>
            <li><strong>Uploaded:</strong> <%= file.uploadedAt.toLocaleDateString() %></li>
        </ul>

        <div class="action-row">
            <a href="/files/<%= file.id %>/download" class="btn">Download</a>
            <a href="/files/<%= file.id %>/rename">Rename</a>
            <form action="/files/<%= file.id %>/delete" method="post">
                <button type="submit" class="btn-link-danger" onclick="return confirm(`Are you sure you want to delete <%= file.name %>?`)">Delete</button>
            </form>
        </div>
    </div>
</body>
</html>