<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=file.name%></title>
</head>
<body>
    <%-include("partials/nav")%>

    <h2><%=file.name%></h2>

    <ul>
        <li><strong>Size:</strong> <%=file.size%> bytes</li>
        <li><strong>Type:</strong> <%=file.mimeType%></li>
        <li><strong>Uploaded:</strong> <%=file.uploadedAt.toLocaleDateString()%></li>
    </ul>

    <a href="/files/<%=file.id%>/download">Download</a>
    <a href="/files/<%=file.id%>/rename">Rename</a>
    <form action="/files/<%=file.id%>/delete" method="post">
        <button type="submit" onclick="return confirm(`Are you sure you want to delete <%=file.name%>?`)">Delete</button>
    </form>
</body>
</html>