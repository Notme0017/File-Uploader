#include <iostream>
#include<vector>
using namespace std;

int partition(vector<int>& arr, int low, int high) {
	int pivot = arr[low];

	int j = high;
	int i = low + 1;
	while (i <= j)
	{
		while (i <= high && arr[i] < pivot)
		{
			i++;
		}

		while (j >= low && arr[j] > pivot)
		{
			j--;
		}

		if (i < j) {
			swap(arr[i], arr[j]);
		}
	}
	swap(arr[low], arr[j]);
	return j;
}

void quicksort(vector<int>& arr, int low, int high)
{
	if (low < high) {

		int part = partition(arr, low, high);

		quicksort(arr, low, part - 1);
		quicksort(arr, part + 1, high);
	}
}

int main()
{
	vector<int>arr = { 11, 51, 25, 16 };
	int n = arr.size();
	quicksort(arr, 0, n - 1);

	for (int i = 0; i < n; i++) {
		cout << arr[i] << " ";
	}

	return 0;
}